# ============================================================================
# Google Places API (New) — SERVER-SIDE credentials only.
# ----------------------------------------------------------------------------
# These power scripts/fetch-google-reviews.mjs (run by the scheduled GitHub
# Action). They are NEVER shipped to the browser and NEVER committed with real
# values. In production, add each one as a GitHub Actions secret:
#   GitHub repo → Settings → Secrets and variables → Actions → New repository secret
# For a local test run, copy this file to `.env` (already git-ignored) and fill
# it in, then: `set -a; source .env; set +a; node scripts/fetch-google-reviews.mjs`
# ============================================================================

# Google Cloud Console → APIs & Services → Credentials → Create API key.
# Enable the "Places API (New)" for the project and restrict this key to it.
GOOGLE_API_KEY=

# OPTIONAL override for the business Place ID. If left empty, the script reads
# the canonical Place ID from config.js → business.googlePlaceId (the same ID
# the site uses for Maps + the "see all reviews" button). Leave this unset.
GOOGLE_PLACE_ID=

# OPTIONAL public "read all reviews on Google" link for the button under the
# cards. If left empty, the site falls back to business.reviewsPageUrl in
# config.js (which is the canonical value for this client).
GOOGLE_REVIEWS_PAGE_URL=