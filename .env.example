# ============================================================================
# Google Business Profile Reviews API — SERVER-SIDE credentials only.
# ----------------------------------------------------------------------------
# These power scripts/fetch-google-reviews.mjs (run by the scheduled GitHub
# Action). They are NEVER shipped to the browser and NEVER committed with real
# values. In production, add each one as a GitHub Actions secret:
#   GitHub repo → Settings → Secrets and variables → Actions → New repository secret
# For a local test run, copy this file to `.env` (already git-ignored) and fill
# it in, then: `set -a; source .env; set +a; node scripts/fetch-google-reviews.mjs`
# ============================================================================

# OAuth 2.0 client (Google Cloud Console → APIs & Services → Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth refresh token obtained once via the consent flow, scope:
#   https://www.googleapis.com/auth/business.manage
GOOGLE_REFRESH_TOKEN=

# From the Business Profile API. Account: accounts/{ACCOUNT_ID} → use the number
# only. Location: accounts/{id}/locations/{LOCATION_ID} → use the id only.
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=

# Public "read all reviews on Google" link for the button under the cards.
GOOGLE_REVIEWS_PAGE_URL=
